{
  "$id": "dynasty.schema.json",
  "title": "Dynasty",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "minLength": 1 },
    "culture": { "type": ["string", "null"], "x-ref": "cultures" },
    "sources": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
