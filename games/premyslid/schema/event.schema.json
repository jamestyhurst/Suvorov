{
  "$id": "event.schema.json",
  "title": "Event",
  "description": "A scripted reaction to something happening in the simulation. Version 0 events exist as exemplars only: they demonstrate the shape the engine will eventually execute. Do not author them in bulk. The `next` tool will not hand out event tasks beyond the exemplar count in the plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "trigger", "effects"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "trigger": {
      "type": "string",
      "enum": ["on_death", "on_birth", "on_succession"],
      "description": "The simulation moment this event fires on. The list is frozen at three until an engine exists."
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect", "target"],
        "properties": {
          "effect": { "type": "string", "enum": ["grant_title", "kill_character", "change_opinion"] },
          "target": { "type": "string", "enum": ["root", "holder", "liege", "primary_heir"] },
          "title": { "type": ["string", "null"], "x-ref": "titles", "description": "Required by grant_title, ignored otherwise." },
          "value": { "type": ["integer", "null"], "minimum": -100, "maximum": 100, "description": "Required by change_opinion, ignored otherwise." }
        }
      }
    },
    "sources": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
